PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/memory-card
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
FRONTEND_URL=http://localhost:3000
# Additional allowed frontend origins, separated by commas (for example an ngrok frontend URL).
CORS_ORIGINS=
# Comma-separated emails receive the admin role when they register.
ADMIN_EMAILS=admin@example.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
